# Only approved public values. Vite exposes all VITE_* variables to browsers.
# Game deployment. For production, use the real HTTPS PointBlock URL.
# In local dev without a value, PLAY NOW uses http://localhost:5173.
VITE_POINTBLOCK_GAME_URL=

# PBT has not launched. Leave empty until the official address is announced.
# A provided value must be a 0x-prefixed, 40-hex-character address.
VITE_PBT_CONTRACT_ADDRESS=

# Official PointBlock community URLs only; leave empty until approved.
VITE_POINTBLOCK_X_URL=
VITE_POINTBLOCK_TELEGRAM_URL=
VITE_POINTBLOCK_DISCORD_URL=
